# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm cache clean --force && \
    npm ci --legacy-peer-deps && \
    rm -rf node_modules/esbuild node_modules/@esbuild && \
    npm install esbuild --force --legacy-peer-deps

COPY . .

# Build shared-utils primero (capa separada para mejor cache)
RUN npm run build -- shared-utils

# Build portal en modo DEVELOPMENT (sin minificación, con source maps)
# Se usa "ng run seis-portal:esbuild:development" en lugar de
# "ng build --configuration development" porque la config 'development'
# del target 'build' tiene "dev: true" que activa el modo live-server
# de native-federation y falla en Docker con exit code 127.
# El target 'esbuild:development' tiene: optimization:false, sourceMap:true.
RUN rm -rf node_modules/.cache node_modules/.vite && \
    ./node_modules/.bin/ng run seis-portal:esbuild:development

# Inyectar base href en el index.html generado
RUN sed -i 's|<base href="/">|<base href="/portal/">|g' \
        dist/seis-portal/browser/index.html && \
    grep 'base href' dist/seis-portal/browser/index.html

# Usar manifest de rutas de producción (MFEs en rutas nginx /mfe-*/remoteEntry.json)
RUN cp projects/seis-portal/public/federation.manifest.prod.json \
       dist/seis-portal/browser/federation.manifest.json


# DEBUG: verificar output
RUN echo "=== [DEBUG BUILD] dist/ ===" && \
    ls -la /app/dist/seis-portal/browser/ && \
    echo "=== federation.manifest.json ===" && \
    cat /app/dist/seis-portal/browser/federation.manifest.json && \
    echo "=== Verificando source maps ===" && \
    find /app/dist/seis-portal/browser -name "*.map" | head -20

# Stage 2: Nginx
FROM nginx:alpine

RUN rm -rf /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/nginx.conf

COPY --from=builder /app/dist/seis-portal/browser /usr/share/nginx/html

RUN echo "=== [DEBUG] Archivos en nginx html ===" && \
    ls -la /usr/share/nginx/html/ && \
    test -f /usr/share/nginx/html/index.html || \
    (echo "ERROR: index.html NO ENCONTRADO" && exit 1)

RUN chmod -R 755 /usr/share/nginx/html && \
    chown -R nginx:nginx /usr/share/nginx/html

RUN nginx -t

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]